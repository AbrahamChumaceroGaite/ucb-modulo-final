# Puerto de este servicio. Spring usa el 8081; la web, el 3408.
PORT=8082
HOST=0.0.0.0
# Prefijo igual al de Spring, para que el BFF de la web arme las rutas igual.
API_PREFIJO=api/v1
# Mismo secreto y emisor con que Spring firma el access token (application.yaml:
# seguridad.jwt.secreto-acceso y seguridad.jwt.emisor). Sin esto ninguna
# petición autenticada pasa.
JWT_SECRET=desarrollo-kaffehaus-secreto-de-acceso-cambiar-en-produccion
JWT_ISSUER=kaffehausv4
# Carpeta con modelo_riesgo.json, calendario.json y lotes_vigentes.json.
MODELO_DIR=./modelo
# Origen del BFF de Next. El navegador nunca llama directo a este servicio.
CORS_ORIGIN=http://localhost:3408
