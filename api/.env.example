# Puerto de la API. La web usa el 3408.
PORT=8082
HOST=0.0.0.0
API_PREFIX=api/v1

# Base de datos de la cafetería, restaurada desde backup.sql (ver README).
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/kaffehausdb

# Secreto para firmar los tokens de sesión: 32 caracteres o más.
# Cámbielo fuera de desarrollo.
JWT_SECRET=desarrollo-kaffehaus-ml-secreto-de-tokens-cambiar
JWT_ISSUER=kaffehaus-ml
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Carpeta con risk_model.json y calendar.json (los copia «npm run model:update»).
MODEL_DIR=./model

# Origen del BFF de Next. El navegador nunca llama directo a la API.
CORS_ORIGIN=http://localhost:3408
